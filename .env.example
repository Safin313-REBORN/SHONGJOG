# ==============================================================================
# SHONGJOG — Environment Configuration
# ==============================================================================

# Adaption Labs API Key for Natural Language Emergency Extraction
# If left empty, SHONGJOG automatically runs in deterministic "Demo AI mode — simulated fallback"
ADAPTION_API_KEY=""

# Adaption API Base URL (defaults to standard endpoint)
ADAPTION_API_URL="https://api.adaptionlabs.ai/v1"

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# Node Environment
NODE_ENV="development"

# Server Port (default: 3000)
PORT=3000
