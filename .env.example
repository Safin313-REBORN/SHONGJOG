# ==============================================================================
# SHONGJOG (সংযোগ) — Environment Configuration
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL / Cloud PostgreSQL)
# Required by Prisma schema: provider = "postgresql"
# Standard pooled connection string:
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Vercel Neon Marketplace Integration (Automatically injected when linked on Vercel)
# Pooled connection string with transaction support:
POSTGRES_PRISMA_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Non-pooling direct connection string for direct migration tasks:
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:YOUR_PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# AI Needs Understanding Engine (Adaption Labs API)
# If omitted or left blank, SHONGJOG automatically runs in deterministic "Demo AI mode — simulated fallback"
ADAPTION_API_KEY=""
ADAPTION_API_URL="https://api.adaptionlabs.ai/v1"

# Gemini Multimodal AI (Optional)
# Enables live Gemini extraction and multimodal triage if provided
GEMINI_API_KEY=""

# Google Maps Platform (Optional)
# If omitted, platform gracefully displays authentic WGS84 embedded Google Maps and navigation links
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAP_ID=""

# Operational Telemetry Mode
NEXT_PUBLIC_SIMULATION_MODE="true"
NEXT_PUBLIC_DEFAULT_REGION="Dacope, Khulna"

# Node Environment & Server Port
NODE_ENV="development"
PORT=3000
